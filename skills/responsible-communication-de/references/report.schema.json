{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Responsible Communication Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mode",
    "document_version",
    "source_check",
    "findings",
    "limitations",
    "changes_applied",
    "publication_authority"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "mode": {
      "enum": [
        "reflect",
        "review",
        "guardrail"
      ]
    },
    "document_version": {
      "type": "string",
      "minLength": 1
    },
    "source_check": {
      "enum": [
        "provided_sources_only",
        "public_research",
        "not_verified"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "quote",
          "criterion",
          "priority",
          "confidence",
          "confidence_reason",
          "observation",
          "evidence_status",
          "question",
          "alternative",
          "policy_rule_id"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "quote": {
            "type": "string",
            "minLength": 1
          },
          "criterion": {
            "enum": [
              "dignity",
              "generalization",
              "evidence",
              "fear_pressure",
              "manipulation",
              "context",
              "privacy",
              "status"
            ]
          },
          "priority": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "confidence": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "confidence_reason": {
            "type": "string"
          },
          "observation": {
            "type": "string"
          },
          "evidence_status": {
            "enum": [
              "supported",
              "open",
              "contradicted",
              "not_applicable"
            ]
          },
          "question": {
            "type": "string"
          },
          "alternative": {
            "type": [
              "string",
              "null"
            ]
          },
          "policy_rule_id": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "changes_applied": {
      "const": false
    },
    "publication_authority": {
      "const": "human"
    },
    "policy_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "policy_version": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "enum": [
              "reflect",
              "guardrail"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "findings": {
            "items": {
              "properties": {
                "alternative": {
                  "type": "null"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "guardrail"
          }
        }
      },
      "then": {
        "required": [
          "policy_id",
          "policy_version"
        ],
        "properties": {
          "policy_id": {
            "type": "string",
            "minLength": 1
          },
          "policy_version": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ]
}
